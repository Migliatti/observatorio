# Copie para .env e ajuste. Validado no boot: a API não sobe com valor inválido.

# Conexão com o Postgres (local: o do docker-compose; produção: Neon).
DATABASE_URL=postgres://observatorio:observatorio@localhost:5432/observatorio

# Banco usado pelos testes de integração (criado e migrado automaticamente pelo Vitest).
TEST_DATABASE_URL=postgres://observatorio:observatorio@localhost:5432/observatorio_test
# Os testes truncam todas as tabelas: o nome do banco deve terminar em _test e o host deve ser local.
# Descomente só se quiser mesmo testar contra um host remoto.
# ALLOW_REMOTE_TEST_DATABASE=1

# Porta e interface HTTP da API.
PORT=3000
HOST=0.0.0.0

# Nível de log do Pino: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Limites locais por processo; buckets por chave usam capacidade 30 e repõem 1 token/s.
RATE_LIMIT_KEY_CAPACITY=30
RATE_LIMIT_KEY_REFILL_PER_SECOND=1
# Limite de IP: 30 pedidos em qualquer janela móvel de 60 segundos, antes da autenticação.
RATE_LIMIT_IP_CAPACITY=30
RATE_LIMIT_IP_WINDOW_SECONDS=60

# Origens exatas que podem chamar rotas de dados no navegador.
# Em produção, configure somente a origem publicada do consumidor; em desenvolvimento,
# mantenha também localhost:5173 e localhost:3000.
CORS_ORIGINS=https://kepler-lab-gamma.vercel.app,http://localhost:5173,http://localhost:3000

# Chave da NASA exigida só por `npm run collect -- neows`. A API não usa esta chave.
# DEMO_KEY serve para experimentar; obtenha sua chave em https://api.nasa.gov/.
NASA_API_KEY=DEMO_KEY
